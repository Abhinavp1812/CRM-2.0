# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env*.local
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Local data and backups (never commit customer data)
# NOTE: *.sql was previously blanket-excluding this too, which silently
# swallowed every prisma/migrations/**/migration.sql - the two migrations
# committed before this rule existed were unaffected (already tracked),
# but every migration since would have been dropped without a trace.
/data/
/backup/
*.sql
!prisma/migrations/**/*.sql